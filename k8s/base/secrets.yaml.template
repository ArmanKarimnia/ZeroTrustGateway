# ==============================================================================
# GitOps Secret Provisioning Template
# DO NOT commit unencrypted secrets to source control.
# In production, manage these via HashiCorp Vault, AWS Secrets Manager,
# or Bitnami SealedSecrets / External-Secrets Operator.
# ==============================================================================

# Keycloak Administrator Credentials
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-admin-secret
  namespace: keycloak
type: Opaque
stringData:
  admin-password: "SuperAdminKeycloakPassword2026!"

---
# Keycloak PostgreSQL Credentials
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-db-secret
  namespace: keycloak
type: Opaque
stringData:
  postgres-password: "KeycloakPostgresPassword2026!"

---
# APISIX Ingress Controller Admin Key
apiVersion: v1
kind: Secret
metadata:
  name: apisix-admin-secret
  namespace: ingress-apisix
type: Opaque
stringData:
  admin-key: "edd1c9f034335f136f87ad84b625c8f1"

---
# APISIX OIDC Client Secret (Matches Keycloak Realm Client Secret)
apiVersion: v1
kind: Secret
metadata:
  name: apisix-oidc-secret
  namespace: ingress-apisix
type: Opaque
stringData:
  client-secret: "apisix-oidc-client-super-secret-2026"
